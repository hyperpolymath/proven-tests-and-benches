    }
  },
  "exit_codes": {
    "proven-tests": {
      "0": "report conforms",
      "1": "report does not conform",
      "2": "no check was performed (missing or unparseable input)"
    },
    "cicd-squabbler": {
      "0": "ok",
      "2": "failure (bad usage, gh failed, unparseable input)",
      "3": "no required_status_checks rule on the base branch",
