# SPDX-License-Identifier: MPL-2.0
# META.a2ml — Project meta-information

[metadata]
project = "proven-tests-and-benches"
author = "Jonathan D.A. Jewell (hyperpolymath) <jonathan.jewell@open.ac.uk>"
license = "MPL-2.0 (code) / CC-BY-SA-4.0 (docs)"
standard = "RSR 2026"
last-updated = "2026-07-02"

[architecture-decisions]
decisions = [
  { id = "ADR-001", title = "Evidence-carrying provenance", status = "accepted", date = "2026-06-24", body = "The three-tier provenance (Actually-Proven / Provisionally-Proven / Unproven) is a data type whose Actually-/Provisionally-Proven constructors REQUIRE their evidence as typed fields (src/ProvenTests/Types.idr: Provenance, ActualEvidence). ActualEvidence.proof_ladder is a non-empty List1, so 'Actually-Proven with zero proof steps' is unrepresentable. A tier cannot be claimed without its justification." },
  { id = "ADR-002", title = "Self-deriving coverage", status = "accepted", date = "2026-06-24", body = "The coverage grid is DERIVED from tests that actually ran and passed (src/ProvenTests/Coverage.idr: coveredFrom, cellCoveredBy), keyed on typed ZigzagCoord. A covered cell cannot be a hand-written claim. The exclusion of Failed/Error/Skipped and inclusion of Passed are machine-checked in src/ProvenTests/Meta.idr (coveredFromExcludesFailure, coveredFromIncludesPass)." },
  { id = "ADR-003", title = "Typed taxonomy axes", status = "accepted", date = "2026-07-02", body = "TestMetadata.category/aspect are Maybe TestCategory / Maybe TestAspect (not stringly). To break the Types<->Taxonomy import cycle, the TestCategory/TestAspect enums live in Types.idr and are re-exported by Taxonomy.idr via `import public`. A metadata record can only name a coordinate that exists in the taxonomy." },
  { id = "ADR-004", title = "Subjects graded from their own ledgers, not re-checked", status = "accepted", date = "2026-07-02", body = "integrations/proven grades proven's modules by parsing proven's own MODULE-STATUS.txt + STATE.a2ml (no code dependency, proofs not re-checked). The strict evidence-carrying reading requires a module to be both proof-bearing AND in proven's zero-OWED clean set to be Actually-Proven; the gap between that and proven's declared tier is the reported drift. Mirrors panic-attack aggregate's trust-by-name stance." },
  { id = "ADR-006", title = "CI on push and pull_request", status = "accepted", date = "2026-08-03", body = "ci.yml runs on push and pull_request (was workflow_dispatch-only, on the false premise that a GitLab job gated). Recorded retroactively 2026-08-10 per GOVERNANCE.md:49; the change itself shipped in PR #21." },
  { id = "ADR-007", title = "proven-spec-suite gated", status = "accepted", date = "2026-08-07", body = "proven-spec-suite.ipkg (75 tests incl. the 12 Actually-Proven theorems) builds and runs in just ci, just test and just test-spec. It had been gated by NOTHING (TEST-NEEDS.md Gap F). Rule: a package enters the gate in the same commit that adds it. Recorded retroactively 2026-08-10." },
  { id = "ADR-008", title = "Estate secret scanner adopted", status = "accepted", date = "2026-08-05", body = "secret-scanner.yml calls hyperpolymath/standards secret-scanner-reusable (gitleaks + rust-secrets + shell-secrets) with secrets: inherit and contents: read. Recorded retroactively 2026-08-10; shipped in PR #26." },
  { id = "ADR-009", title = "TypeSafeTest is a LOCAL taxonomy extension pending ratification", status = "accepted", date = "2026-08-10", body = "The estate taxonomy defines 16 categories; this repo implements a 17th, TypeSafeTest. Owner ruling 2026-08-10: propose upstream as category 18 (with category 17 = Coupling/Drift-freedom, delivering the standard's own v1.1 promise). Until that standards PR merges, every surface states 16+1-local; the lattice does NOT grow ahead of ratification." },
  { id = "ADR-010", title = "gh actions-lock is the pin; Dependabot is a notifier", status = "accepted", date = "2026-08-10", body = "Workflows carry symbolic version refs; .github/workflows/actions.lock carries resolved SHAs; pure reusable-caller workflows appear as bare []. Dependabot actions-PRs are policy-refused on pull_request events on this account (measured: PR #29, all three workflows startup_failure 0s while identical content ran green on main) and mislabel pins; they are closed and re-locked via the tool. See DEBT I-10." },
  { id = "ADR-005", title = "Toolchain Idris2 0.7.0", status = "accepted", date = "2026-08-03", supersedes = "ADR-005 (2026-07-02, declared 0.8.0)", body = "The build targets Idris2 0.7.0, built from source against the Chez Scheme backend by scripts/install-idris2.sh. scripts/ci-build.sh derives the support-library path by glob rather than hardcoding a version. CORRECTION 2026-08-03: this ADR previously declared 0.8.0 to align with proven, but no executable path ever used it — the installer, both CI pipelines and the README all pinned 0.7.0, and 0.7.0 is what builds green (verified: full ci-build.sh run, 52/52 type-safe suite passing). The 0.8.0 figure was an aspiration recorded as a decision. Drift between this ADR and the executable pins is now gated by scripts/check-toolchain-pins.sh. Moving to 0.8.0 is tracked as future work and must change every artefact that script checks, in one commit." },
]

[provenance-tiers]
tiers = ["Actually-Proven", "Provisionally-Proven", "Unproven"]
evidence-carrying = true
actually-proven-requires = "non-empty proof ladder (List1 ProofStep) citing machine-checked theorems"
banned-in-actually-proven = ["believe_me", "assert_total", "%partial", "unsafePerformIO"]
report-schema = "src/ProvenTests/Report.idr runReportJSON, schema_version 1"
