#
# GENERATED — DO NOT HAND-EDIT. Regenerate with: just corpus-count
#
# THE COUNT LEDGER — the public claim. Six numbers, never one. A number is
# quotable only if every unit in it is individually executable, individually
# red-able, carries its canonical wrongness, declares its confusables, states
# an error model, and has been run more than once. Any shortfall prints as a
# DEFICIT, never buried.
#
# Every field is computed from the per-unit manifests under corpus/ by
# scripts/check-doc-facts.sh. `check-doc-facts.sh source` fails if this file
# and a fresh walk disagree, so a hand-edit here is drift, not an update.

[count]
deployed = "1"
fired_with_date = "1"
diagnosticity_complete = "1"
proven_exact = "1"
statistical_with_declared_operating_point = "0"
repeat_tested = "1"

[detail]
last_fired = "2026-09-15T02:06:33Z (provenance/reflexive/cancelled-gate-void)"
authority = "each unit stability.a2ml [firing_history].last_fired; this line is DERIVED"

[deficits]
ci_gate = "no workflow runs the corpus mode — units are compiled and fired locally only (DEBT S-9)"
reproduce_tested = "0 of 1 — second-machine runs owed (DEBT S-9)"
replicate_tested = "0 of 1 — different-setup runs owed (DEBT S-9)"

# Each zero below names the CHECK that enforces it. A zero asserted by
# nobody is a wish; a zero enforced by a named gate is a measurement. This
# section was [zero_by_assertion] until WS1 commit C gave every line a gate.
[zero_by_gate]
cannot_fail_by_design = "0 — enforced by corpus_fire <unit> fixture-firing 1 (check-doc-facts.sh corpus): a unit whose firing fixture exits 0 is reported, never counted"
undeclared_error_model = "0 — enforced by corpus_check_spine (error-model.a2ml is a contract member) and by check_unit_ledger (a proven-exact tier must name lemmas that exist in Test.idr)"
void_counted_as_pass = "0 — enforced by corpus_fire <unit> calibration 2 (check-doc-facts.sh corpus): a calibration payload exiting 0 is reported, never counted"

[units]
u1 = "provenance/reflexive/cancelled-gate-void tier=proven-exact runs=3 last_fired=2026-09-15T02:06:33Z"
