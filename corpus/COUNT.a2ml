#
# THE COUNT LEDGER — the public claim. Six numbers, never one. A number is
# quotable only if every unit in it is individually executable, individually
# red-able, carries its canonical wrongness, declares its confusables, states
# an error model, and has been run more than once. Any shortfall prints as a
# DEFICIT, never buried.
#
# Hand-written while the corpus is small; to be regenerated by CI once
# `corpus-check` exists (that gap is DEBT S-9).

[count]
deployed = "1"
fired_with_date = "1"
diagnosticity_complete = "1"
proven_exact = "1"
statistical_with_declared_operating_point = "0"
repeat_tested = "1"

[detail]
last_fired = "2026-08-31 (cancelled-gate-void, exit 1 against fixture-firing)"
repeat_protocol = "N=3 same machine, variance 0 — see the unit's stability.a2ml"

[deficits]
reproduce_tested = "0 of 1 — no second-machine run yet (DEBT S-9)"
ci_gate = "no CI job yet compiles and runs corpus units standalone (DEBT S-9)"

[zero_by_assertion]
cannot_fail_by_design = "0"
undeclared_error_model = "0"
void_counted_as_pass = "0"

[units]
u1 = "provenance/reflexive/cancelled-gate-void — proven-exact, fired 2026-08-31"
