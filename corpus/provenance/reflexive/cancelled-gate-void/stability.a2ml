#
# Stability record (exactness spine X.8): repeat / reproduce / replicate,
# with dates. A unit never run twice has an unmeasured alpha and cannot be
# counted — this file is what makes the count honest.
#
# 2026-09-15 (WS1 commit A): [machine_compile] below is the first SCRIPTED,
# three-signal-instrumented compile of this unit, superseding the author's
# 2026-08-31 hand-run as the primary record. [repeat] is retained as history,
# demoted, not deleted.
#
# Be precise about what this is NOT, because the surrounding sections would
# otherwise contradict it. It is the SAME MACHINE as the hand-run (see
# [reproduce], still owed). And it does not discharge R-29: R-29's "done" is
# CI compiling and running the unit, which is WS1 commit D. This run is the
# evidence commit D is built on, not a substitute for it.

[repeat]
machine = "same machine (WSL2, Linux 6.18.33.2-microsoft-standard-WSL2, idris2 0.7.0, Chez backend)"
runs = "3"
date = "2026-08-31T21:08:05Z"
protocol = "full triple per run: fixture-silent, fixture-firing, calibration/empty-report"
outcomes = "identical across all 3 runs: silent=0 firing=1 calibration=2"
variance = "0 — deterministic pure function of input bytes, no timing component"
provenance = "HAND-RUN by the unit's author; superseded as the primary record by [machine_compile]"

[machine_compile]
# The first scripted, instrumented compile. Same machine as [repeat]; see the
# header note. R-29's CI condition is discharged by WS1 commit D, not here.
date = "2026-09-15T02:06:33Z"
toolchain = "Idris 2, version 0.7.0 (Chez backend), IDRIS2_PREFIX=$HOME/.idris2, WSL2"
source_sha256 = "d27530e24f178b50629b40e60eb623b06b41c1dd63fff179bb1165ecc5bf6b61"
invocation = "idris2 Test.idr -o cancelled-gate-void — standalone, NO .ipkg, no -p flag (R-43)"
build_state = "rm -rf build before the run; nothing pre-existing was reused"
rc = "0"
error_lines = "0"
binary = "build/exec/cancelled-gate-void — PRESENT and executable"
verdict = "COMPILED under the three-signal predicate below"

[compile_predicate]
# MEASURED 2026-09-14/15. Neither signal alone is sound on the standalone path
# this corpus is required by R-43 to use. See [toolchain_caveat].
definition = "compiled IFF rc == 0 AND build/exec/<name> exists and is executable AND zero ^Error: lines on combined stdout+stderr"
why_rc_insufficient = "an unresolvable import exits 0 while printing Error: and emitting no binary"
why_binary_insufficient = "a type error exits 1 yet a binary IS still emitted under -o"
enforcement = "WS1 commit D's corpus-check job; the natural refactor to a bare && silently re-admits a bad import"

[triple]
# The 0/1/2 outcome convention (docs/TEST-DOCTRINE.adoc). All three measured in this run.
silent = "fixture-silent/report.txt -> rc=0 -- SILENT: no cancelled job behind a PASS claim"
firing = "fixture-firing/report.txt -> rc=1 -- FIRED: cancelled-adjudicator-reported-as-pass — verdict PASS while a job's conclusion is cancelled (must be VOID)"
calibration = "calibration/empty-report.txt -> rc=2 -- NO CHECK PERFORMED: fixture unparseable or incomplete"
result = "all three MATCH the declared outcomes; the firing arm and the silent arm are both reachable (verification rule 4)"

[isolation]
# R-43: isolation is REAL, not declared. A unit that accidentally imports the
# library must fail to compile, and that failure IS the gate. Measured, not asserted.
probe = "insert `import ProvenTests.Types` immediately after `module Test`, recompile from a clean build/"
error_text = "Error: Module ProvenTests.Types not found"
location = "Test:27:1--27:25 (the inserted import's own line)"
rc = "0 — ⚠ the exit code does NOT report this failure; see [toolchain_caveat]"
error_lines = "2"
binary = "ABSENT — no executable is produced"
verdict = "NOT COMPILED under the three-signal predicate — isolation HOLDS"
detected_by = "error text and binary absence, NEVER by exit code"
positive_control = "`import Data.Vect` (resolvable) -> rc=0, 0 error lines, binary PRESENT = COMPILED — so the probe discriminates rather than rejecting every import"
restored = "Test.idr restored and verified byte-identical (git diff --quiet) after every mutation"

[toolchain_caveat]
# Filed as a CANDIDATE corpus specimen `fatal-error-exits-zero`, deliberately not
# a unit in this pass so the declared count of new units stays honest.
defect = "Idris 2 v0.7.0 exits 0 on module-not-found in the STANDALONE path (idris2 <file> --check and idris2 <file> -o <name>)"
confirmed_on = "ProvenTests.Types, Totally.Bogus.Nonexistent; control Data.Vect resolves and compiles"
scope = "confined to the standalone path — `idris2 --build <ipkg>` correctly exits 1 on the same bogus import AND on a type error"
consequence = "ptb's existing CI (Idris2) uses --build and needs no caveat; the CORPUS, and only the corpus, sits on the untrustworthy path by R-43"
mitigation = "the three-signal predicate above, enforced in CI by WS1 commit D"

[reproduce]
performed = "no"
owed = "run on a second machine; recorded as DEBT S-9 until done — the deficit is declared, not hidden"

[replicate]
performed = "no"
owed = "different setup (different Idris2 backend or version); deferred with reproduce"

[firing_history]
# The adversarial-manifest rule: a fixture that has never fired is a finding,
# not a fixture. This fixture HAS fired.
first_fired = "2026-08-31T21:07Z"
last_fired = "2026-09-15T02:06:33Z"
last_fired_by = "machine (WS1 commit A) — the 2026-08-31T21:08:05Z hand-run is retained in [repeat]"
