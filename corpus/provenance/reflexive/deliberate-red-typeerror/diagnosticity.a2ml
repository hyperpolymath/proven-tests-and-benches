#
# Diagnosticity contract for corpus unit provenance/reflexive/cancelled-gate-void.
# Every confusable below is either discharged by distinguishing evidence or
# declared in does_not_distinguish — nothing is silently unresolved.

[detects]
condition = "a CI gate report that claims verdict PASS while at least one of its jobs has conclusion `cancelled`"
defect_class = "cancelled-adjudicator-reported-as-pass"
ground_truth = "proven's `idris2 --build` job cancelled at the 45-minute timeout on every main run (run 31659335180 measured 2026-08-27); the type-check step never executed; the gate read green"

[sensitivity]
# Variants of the detected condition this unit provably catches. The warrant is
# a total lemma, not a sample: firesOnCancelledPass in Test.idr quantifies over
# ALL job lists, so every arity and position of the cancelled job is covered.
variant_1 = "any number of jobs, cancelled job in any position — covered by the universally quantified lemma firesOnCancelledPass"
firing_fixture = "fixture-firing/report.txt (adjudicating job cancelled, verdict PASS)"

[confusables]
# Other causes producing a similar surface signal, each discharged or declared.
skipped_job = "a job with conclusion `skipped` is condition-gated and INTENTIONAL (e.g. a mirror workflow that only runs on its trigger); it must not fire this unit"

[distinguishing_evidence]
skipped_job = "the grammar carries `skipped` and `cancelled` as distinct tokens; the checker consumes them as distinct constructors, and the total lemma skippedIsNotCancelled proves a skipped job can never satisfy the firing predicate"
emitted = "exit code (0/1/2) plus a one-line verdict naming the defect class when fired; parse failures emit NO CHECK PERFORMED, never silence"

[does_not_distinguish]
timeout_vs_concurrency = "a cancellation caused by a step timeout versus one caused by a concurrency-group eviction — the report grammar carries only the conclusion, not the cancellation cause"
cancelled_behind_fail = "a cancelled job reported as FAIL is a conservative misreport (red where VOID is owed); it is outside this unit's declared axis and stays silent here"
