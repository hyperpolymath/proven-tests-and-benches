#
# Unit manifest for corpus/provenance/reflexive/setup-failure-reported-as-subject-failure.

[identity]
battery = "provenance"
category = "ReflexiveTest"
aspect = "Dependability"
defect_class = "setup-failure-reported-as-subject-failure"

[classification]
proof_system = "Idris2 total functions with machine-checked equality proofs"
type_level = "dependent equality types over the report grammar"
semiotic_level = "semantic"
semiotic_justification = "the check adjudicates what the report MEANS — whether a FAIL verdict is warranted by a failure of the subject or only by failures that preceded it — not merely whether it parses; it stops short of pragmatic (it does not observe a live gate in use)"
warrant_class = "measured-defect"
warrant_note = "grounded in a measured estate failure (plasma-parser-writer, 2026-09-29 to 2026-10-14, run 38564229091), not in prevalence or precedent — R-9 incumbency cap does not apply"

[subject_shape]
input = "a gate report in the declared line grammar (see regime.a2ml); producible from any CI system that exposes per-job step outcomes (for GitHub Actions: jobs[].steps[].conclusion via the runs API, classifying a failing step as setup if it precedes the first subject step)"
build = "standalone: `idris2 Test.idr -o setup-failure-reported-as-subject-failure` — base library only, no .ipkg, no sibling imports"

[shared_dependencies]
# Triangulation ledger entry (X.6): components shared with other units, which
# bound any claimed independence.
toolchain = "idris2 0.8.0 (Chez Scheme backend) for the recorded runs; the repository's CI pin is 0.7.0 — see stability.a2ml [toolchain_note]"
harness_lineage = "hand-written, modelled on cancelled-gate-void's parser and lemma shape; no shared fixture generator; fixtures are hand-authored on-disk pairs"

[adversarial]
# ⚠ THIRD assertion site for one fact. The same date is asserted in
# stability.a2ml [firing_history] and derived into corpus/COUNT.a2ml.
# stability.a2ml is the AUTHORITY; check_unit_ledger (check-doc-facts.sh)
# fails the tree if this line and stability.a2ml disagree.
last_fired = "2026-10-19"
