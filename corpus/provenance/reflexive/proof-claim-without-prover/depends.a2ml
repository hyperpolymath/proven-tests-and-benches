#
# Validity preconditions (exactness spine X.5). Violation of any precondition
# yields exit 2 (VOID), and VOID propagates: a battery must reclassify any
# green downstream of this unit's VOID as VOID.

[upstream_units]
value = "none — the unit compiles and runs alone; it depends on no other unit's output"

[preconditions]
fixture_readable = "the report file must exist and be readable — violation exits 2 (NO CHECK PERFORMED)"
fixture_in_grammar = "the report must parse under the declared grammar — violation exits 2"
claim_scan_honest = "the producer must report `claimed yes` for every prover the tree advertises (README, badge, manifest) — a producer that scans only one of those surfaces under-reports claims, and an under-reported claim is a parse-valid report this unit judges as written"

[void_behaviour]
convention = "exit 2 means NO CHECK WAS PERFORMED; it is never a pass and never a failure — a crash is 2, an empty payload is 2 (see calibration/)"
