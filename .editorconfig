# proven-tests-and-benches - Editor Configuration
# https://editorconfig.org

root = true
[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true
[*.md]
trim_trailing_whitespace = false
[*.adoc]
# Idris2 — this repository's only source language. Absent until 2026-08-03,
# despite 37 .idr files; the block below was inherited from a template that
# had no Idris2 in it. 2-space indent matches the existing sources.
[*.idr]
[*.ipkg]
[*.rs]
indent_size = 4
[*.ex]
[*.exs]
[*.zig]
[*.ada]
indent_size = 3
[*.adb]
[*.ads]
[*.hs]
[*.res]
[*.resi]
[*.ncl]
[*.rkt]
[*.scm]
[*.nix]
[Justfile]
# SPDX-License-Identifier: MPL-2.0
[justfile]
[Makefile]
indent_style = tab
